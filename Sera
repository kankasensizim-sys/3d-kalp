<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1.0,
maximum-scale=1.0,
user-scalable=no">

<title>3D Hearts</title>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    touch-action: none;
}

canvas {
    display: block;
}
</style>
</head>

<body>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>

let scene;
let camera;
let renderer;

const hearts = [];


// =========================
// SAHNE
// =========================

scene = new THREE.Scene();

scene.background =
    new THREE.Color(0x000000);


// =========================
// KAMERA
// =========================

camera = new THREE.PerspectiveCamera(
    60,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
);

camera.position.z = 32;


// =========================
// RENDERER
// =========================

renderer = new THREE.WebGLRenderer({
    antialias: true
});

renderer.setPixelRatio(
    Math.min(window.devicePixelRatio, 2)
);

renderer.setSize(
    window.innerWidth,
    window.innerHeight
);

document.body.appendChild(
    renderer.domElement
);


// =========================
// IŞIK
// =========================

const light =
    new THREE.AmbientLight(
        0xffffff,
        2
    );

scene.add(light);


// =========================
// GERÇEK KALP GEOMETRİSİ
// =========================

const heartShape =
    new THREE.Shape();

heartShape.moveTo(0, -2);

heartShape.bezierCurveTo(
    -5, -7,
    -11, -3,
    -11, 2
);

heartShape.bezierCurveTo(
    -11, 8,
    -5, 11,
    0, 15
);

heartShape.bezierCurveTo(
    5, 11,
    11, 8,
    11, 2
);

heartShape.bezierCurveTo(
    11, -3,
    5, -7,
    0, -2
);


const heartGeometry =
    new THREE.ExtrudeGeometry(
        heartShape,
        {
            depth: 1.2,
            bevelEnabled: true,
            bevelSegments: 3,
            bevelSize: 0.5,
            bevelThickness: 0.4
        }
    );

heartGeometry.center();


// =========================
// KALP MATERYALİ
// =========================

const heartMaterial =
    new THREE.MeshStandardMaterial({

        color: 0xff2f75,

        emissive: 0xff0055,

        emissiveIntensity: 0.7,

        metalness: 0.1,

        roughness: 0.25
    });


// =========================
// KALPLER
// =========================

for (let i = 0; i < 35; i++) {

    const heart =
        new THREE.Mesh(
            heartGeometry,
            heartMaterial.clone()
        );


    heart.userData = {

        radius:
            8 + Math.random() * 14,

        angle:
            Math.random() *
            Math.PI * 2,

        speed:
            0.003 +
            Math.random() * 0.008,

        y:
            -18 +
            Math.random() * 36,

        rotation:
            0.005 +
            Math.random() * 0.015
    };


    // Daha küçük kalpler
    const scale =
        0.08 +
        Math.random() * 0.16;

    heart.scale.set(
        scale,
        scale,
        scale
    );


    heart.position.x =
        Math.cos(
            heart.userData.angle
        ) *
        heart.userData.radius;


    heart.position.z =
        Math.sin(
            heart.userData.angle
        ) *
        heart.userData.radius;


    heart.position.y =
        heart.userData.y;


    heart.rotation.x =
        Math.random() * Math.PI;

    heart.rotation.y =
        Math.random() * Math.PI;


    scene.add(heart);

    hearts.push(heart);
}


// =========================
// ANİMASYON
// =========================

function animate() {

    requestAnimationFrame(
        animate
    );


    hearts.forEach(
        function(heart) {

            // Yukarı hareket
            heart.position.y +=
                heart.userData.speed;


            // Dönme
            heart.rotation.x +=
                heart.userData.rotation;

            heart.rotation.y +=
                heart.userData.rotation;


            // Üstten çıkınca tekrar aşağı
            if (
                heart.position.y > 20
            ) {

                heart.position.y = -20;

                heart.userData.radius =
                    8 + Math.random() * 14;

                heart.userData.angle =
                    Math.random() *
                    Math.PI * 2;


                heart.position.x =
                    Math.cos(
                        heart.userData.angle
                    ) *
                    heart.userData.radius;


                heart.position.z =
                    Math.sin(
                        heart.userData.angle
                    ) *
                    heart.userData.radius;
            }

        }
    );


    camera.lookAt(
        0,
        0,
        0
    );


    renderer.render(
        scene,
        camera
    );
}


// =========================
// TELEFON EKRANI
// =========================

window.addEventListener(
    "resize",
    function() {

        camera.aspect =
            window.innerWidth /
            window.innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            window.innerWidth,
            window.innerHeight
        );
    }
);


animate();

</script>

</body>
</html>
